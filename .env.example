# --- Database ---
DATABASE_URL=postgresql+psycopg2://report_validator:change_me@postgres:5432/report_validator

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Must be a DIFFERENT random value from JWT_SECRET — this one encrypts
# secrets at rest (platform API credentials), JWT_SECRET signs auth tokens.
ENCRYPTION_SECRET=change_me_to_a_different_long_random_value

# --- AI / Ollama (optional; system works without it, falls back to rule-based engine) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# --- OSINT / Search providers (optional, leave blank to disable) ---
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- Official platform APIs (optional, leave blank; system falls back to manual reporting mode) ---
PLATFORM_API_KEY=

# --- Storage ---
STORAGE_PATH=/app/storage/evidence
MAX_UPLOAD_MB=25

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Retention (days) ---
EVIDENCE_RETENTION_DAYS=365
CASE_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
